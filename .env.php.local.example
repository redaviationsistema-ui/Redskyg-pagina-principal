# Copy to .env.php.local (ignored by Git). Used only by npm run dev:php.
# Set the actual SMTP test configuration. Never use VITE_ for private values.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SKY_INQUIRY_RECIPIENT=
# Use a controlled SMTP test mailbox. No messages are sent at startup.
