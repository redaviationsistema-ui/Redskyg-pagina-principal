# PHP environment only. Never use VITE_ for these values or put secrets in public/.
SKY_INQUIRY_ORIGINS=https://redskyg.com,https://www.redskyg.com
SKY_INQUIRY_STATE_DIR=/home/ACCOUNT/skygroup-inquiry-state
# Generate a random secret of at least 32 characters on the hosting.
SKY_INQUIRY_SECRET=
# Optional private bootstrap path when deployment uses a different structure:
# SKY_INQUIRY_BOOTSTRAP=/home/ACCOUNT/skygroup-private/php/bootstrap.php
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Fixed internal recipient, verified by the hosting administrator:
SKY_INQUIRY_RECIPIENT=

# Frontend public configuration (existing endpoint, unchanged):
VITE_AIRCRAFT_INQUIRY_URL=/aircraft-inquiry.php
VITE_AIRCRAFT_INQUIRY_VERIFIED=false

# Vite development proxy, local PHP only:
SKY_PHP_DEV_TARGET=http://127.0.0.1:8085
# The PHP test launcher allows local Vite origins by default; production uses
# SKY_INQUIRY_ORIGINS configured explicitly for its real domain.
