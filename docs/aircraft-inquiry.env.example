# Recommended in production and local development with the Vite proxy:
VITE_AIRCRAFT_INQUIRY_URL=/aircraft-inquiry.php
# Absolute URL only when the hosting explicitly permits the frontend origin:
# VITE_AIRCRAFT_INQUIRY_URL=https://redskyg.com/aircraft-inquiry.php
# Keep false until an authorized real delivery test has succeeded.
VITE_AIRCRAFT_INQUIRY_VERIFIED=false
